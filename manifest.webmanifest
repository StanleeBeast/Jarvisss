{
  "name": "J.A.R.V.I.S. Personal Assistant",
  "short_name": "JARVIS",
  "description": "Persönlicher KI-Assistent J.A.R.V.I.S.S. mit Stimme, Aufgaben, Briefing und Systemstatus.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070605",
  "theme_color": "#070605",
  "orientation": "any",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "id": "./",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "shortcuts": [
    {
      "name": "Briefing",
      "url": "./?do=briefing"
    },
    {
      "name": "Tagesplan",
      "url": "./?open=day"
    },
    {
      "name": "Mails",
      "url": "./?open=mail"
    }
  ]
}