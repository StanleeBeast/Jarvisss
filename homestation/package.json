{
  "name": "jarvis-home-station",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS Home-Station: holt Mails per IMAP, sendet bestätigte Antworten per SMTP und meldet sich beim JARVIS-Worker.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "build": "esbuild src/index.js --bundle --platform=node --target=node18 --format=cjs --minify --legal-comments=eof --outfile=jarvis-station.cjs"
  },
  "dependencies": {
    "imapflow": "2.1.2",
    "mailparser": "3.9.32",
    "nodemailer": "10.0.13"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
